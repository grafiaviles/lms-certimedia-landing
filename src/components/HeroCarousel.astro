---
import Icon from './Icon.astro';
import Avatar from './Avatar.astro';
import {
  demoOtecName,
  demoGlobal,
  demoCohortesVigentes,
  demoAvancePromedioGlobal,
  demoCohorteDestacada,
} from '../content/demoData';

// Mockup del hero que rota entre los componentes principales del software.
// Todo HTML/CSS/SVG (sin imágenes externas). Auto-rota, pausa al pasar el mouse/teclado
// y respeta prefers-reduced-motion.
// Todos los números vienen de `demoData` (una sola fuente), para que no se contradigan
// entre slides ni con el resto de la landing.
const slides = [
  { id: 'panel', title: 'Control · Panel general' },
  { id: 'metricas', title: 'Control · Reportes y trazabilidad' },
  { id: 'sence', title: 'Control · Cumplimiento SENCE' },
  { id: 'cohorte', title: 'Campus · Cohorte y personas' },
];

const { diasParaCierre, cohortesPendientes } = demoGlobal.declaracionJurada;
const cohorteDestacada = demoCohorteDestacada;
---

<div class="mx-auto w-full max-w-md" data-hero-carousel>
  <div class="overflow-hidden rounded-2xl border border-ink-200 bg-white shadow-soft sm:rounded-card">
    <div class="flex items-center gap-2 border-b border-ink-100 bg-ink-50 px-4 py-3">
      <span class="h-2.5 w-2.5 rounded-full bg-ink-300"></span>
      <span class="h-2.5 w-2.5 rounded-full bg-ink-300"></span>
      <span class="h-2.5 w-2.5 rounded-full bg-ink-300"></span>
      <span class="ml-2 flex-1 truncate text-xs font-medium text-ink-500" data-carousel-title>
        {slides[0].title}
      </span>
      <span class="shrink-0 rounded-full bg-ink-200 px-2 py-0.5 text-[10px] font-medium text-ink-600">
        Datos de ejemplo
      </span>
    </div>

    <div class="relative h-[416px]">
      {/* Slide 1 · Panel general (alcance: todas las cohortes) */}
      <div class="absolute inset-0 space-y-4 p-4 transition-opacity duration-500 sm:p-5" data-slide="0">
        <div class="flex items-start gap-3 rounded-xl border border-accent-200 bg-accent-50 p-3">
          <Icon name="bell" class="mt-0.5 h-5 w-5 shrink-0 text-accent-700" />
          <div>
            <p class="text-sm font-semibold text-accent-800">Declaración Jurada SENCE</p>
            <p class="text-xs text-accent-700">
              Cierra en {diasParaCierre} días · {cohortesPendientes} cohortes pendientes
            </p>
          </div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="rounded-xl border border-ink-100 p-3">
            <p class="text-xs text-ink-500">Asistencia</p>
            <p class="mt-1 text-xl font-bold text-ink-900">{demoGlobal.asistenciaSencePromedio}%</p>
          </div>
          <div class="rounded-xl border border-ink-100 p-3">
            <p class="text-xs text-ink-500">Cohortes</p>
            <p class="mt-1 text-xl font-bold text-ink-900">{demoGlobal.cohortesTotal}</p>
          </div>
          <div class="rounded-xl border border-ink-100 p-3">
            <p class="text-xs text-ink-500">Empresas</p>
            <p class="mt-1 text-xl font-bold text-ink-900">{demoGlobal.empresasCliente}</p>
          </div>
        </div>
        <div class="rounded-xl border border-ink-100 p-4">
          <p class="mb-3 text-xs font-medium text-ink-500">Avance por cohorte vigente</p>
          <div class="space-y-2.5">
            {
              demoCohortesVigentes.map((row) => (
                <div>
                  <div class="mb-1 flex items-center justify-between text-xs text-ink-600">
                    <span>{row.nombre}</span>
                    <span class="font-medium text-ink-800">{row.avance}%</span>
                  </div>
                  <div class="h-2 overflow-hidden rounded-full bg-ink-100">
                    <div class="h-full rounded-full bg-accent-500" style={`width: ${row.avance}%`} />
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </div>

      {/* Slide 2 · Métricas del negocio (alcance: todas las cohortes) */}
      <div
        class="pointer-events-none absolute inset-0 space-y-3 p-4 opacity-0 transition-opacity duration-500 sm:p-5"
        data-slide="1"
      >
        <div class="flex items-center justify-between">
          <p class="text-sm font-semibold text-ink-900">Reportes y trazabilidad</p>
          <span class="rounded-full bg-accent-50 px-2.5 py-1 text-[11px] font-medium text-accent-700">
            {demoOtecName}
          </span>
        </div>

        <div class="grid grid-cols-2 gap-2.5">
          {
            [
              {
                value: String(demoGlobal.cohortesVigentes),
                label: 'Cohortes vigentes',
                note: `de ${demoGlobal.cohortesTotal} en total`,
                tone: 'ink',
              },
              {
                value: String(demoGlobal.alumnosEnCurso),
                label: 'Alumnos en curso',
                note: 'en cohortes activas',
                tone: 'ink',
              },
              {
                value: `${demoAvancePromedioGlobal}%`,
                label: 'Avance promedio',
                note: 'módulos completados',
                tone: 'accent',
              },
              {
                value: String(cohorteDestacada.enRiesgoCount),
                label: 'En riesgo',
                note: 'avance bajo 30%',
                tone: 'amber',
              },
            ].map((m) => (
              <div class="rounded-xl border border-ink-100 p-3">
                <p
                  class:list={[
                    'text-2xl font-bold',
                    m.tone === 'accent' ? 'text-accent-600' : m.tone === 'amber' ? 'text-amber-600' : 'text-ink-900',
                  ]}
                >
                  {m.value}
                </p>
                <p class="mt-0.5 text-xs font-semibold text-ink-800">{m.label}</p>
                <p class="text-[11px] text-ink-500">{m.note}</p>
              </div>
            ))
          }
        </div>

        <div class="flex items-center justify-between rounded-xl border border-accent-200 bg-accent-50 p-3.5">
          <div>
            <p class="text-xs font-semibold text-ink-800">Asistencia SENCE</p>
            <p class="text-[11px] text-ink-500">promedio de sesiones registradas</p>
          </div>
          <p class="text-2xl font-bold text-accent-700">{demoGlobal.asistenciaSencePromedio}%</p>
        </div>
      </div>

      {/* Slide · Cumplimiento SENCE (alcance: cohorte destacada) */}
      <div
        class="pointer-events-none absolute inset-0 space-y-3 p-4 opacity-0 transition-opacity duration-500 sm:p-5"
        data-slide="sence"
      >
        <div class="flex items-center justify-between">
          <p class="text-sm font-semibold text-ink-900">Cumplimiento SENCE</p>
          <span class="rounded-full bg-accent-50 px-2.5 py-1 text-[11px] font-medium text-accent-700">
            {cohorteDestacada.nombre}
          </span>
        </div>

        <div class="rounded-xl border border-accent-200 bg-accent-50 p-3">
          <p class="text-xs leading-relaxed text-accent-800">
            <span class="font-bold">
              {cohorteDestacada.cumplenCount} de {cohorteDestacada.alumnos.length}
            </span>{' '}
            alumnos cumplen hoy el {cohorteDestacada.umbralAsistencia}% de asistencia
          </p>
        </div>

        <div class="space-y-2">
          {
            cohorteDestacada.alumnos.map((r) => (
              <div class="flex items-center justify-between rounded-xl border border-ink-100 px-3 py-2.5">
                <div class="min-w-0">
                  <p class="truncate text-sm font-medium text-ink-800">{r.nombre}</p>
                  <p class="text-[11px] text-ink-500">
                    Asistencia {r.sesionesAsistidas} de {cohorteDestacada.totalSesiones} · {r.asistenciaPct}%
                  </p>
                </div>
                <span
                  class:list={[
                    'shrink-0 rounded-full px-2.5 py-1 text-[11px] font-semibold',
                    r.cumpleAsistencia ? 'bg-emerald-50 text-emerald-700' : 'bg-red-50 text-red-600',
                  ]}
                >
                  {r.cumpleAsistencia ? 'Cumple' : 'No cumple'}
                </span>
              </div>
            ))
          }
        </div>
      </div>

      {/* Slide 3 · Cohorte y personas (alcance: cohorte destacada) */}
      <div
        class="pointer-events-none absolute inset-0 space-y-3 p-4 opacity-0 transition-opacity duration-500 sm:p-5"
        data-slide="2"
      >
        <div class="flex items-center justify-between">
          <p class="text-sm font-semibold text-ink-900">{cohorteDestacada.nombre}</p>
          <span class="text-xs text-ink-500">{cohorteDestacada.alumnos.length} personas</span>
        </div>
        {
          cohorteDestacada.alumnos.map((p, idx) => (
            <div class="flex items-center gap-3 rounded-xl border border-ink-100 p-2.5">
              <Avatar variant={idx} class="h-9 w-9 shrink-0 rounded-full" />
              <div class="min-w-0 flex-1">
                <div class="mb-1 flex items-center justify-between gap-2">
                  <span class="truncate text-sm font-medium text-ink-800">{p.nombre}</span>
                  <span class="shrink-0 text-xs font-semibold text-ink-700">{p.avance}%</span>
                </div>
                <div class="h-1.5 overflow-hidden rounded-full bg-ink-100">
                  <div class="h-full rounded-full bg-accent-500" style={`width: ${p.avance}%`} />
                </div>
              </div>
            </div>
          ))
        }
      </div>

    </div>
  </div>

  {/* Indicadores / controles: botón con área táctil de 24px mínimo, indicador visual más chico adentro. */}
  <div class="mt-4 flex items-center justify-center gap-1" role="tablist" aria-label="Vistas del producto">
    {
      slides.map((s, i) => (
        <button
          type="button"
          role="tab"
          aria-selected={i === 0 ? 'true' : 'false'}
          aria-label={s.title}
          data-dot={i}
          class="flex h-6 w-6 items-center justify-center"
        >
          <span
            data-dot-visual
            class:list={[
              'h-2 rounded-full transition-all duration-300',
              i === 0 ? 'w-6 bg-accent-600' : 'w-2 bg-ink-300',
            ]}
          />
        </button>
      ))
    }
  </div>
</div>

<script>
  (function () {
    const root = document.querySelector('[data-hero-carousel]');
    if (!root) return;

    const slides = Array.from(root.querySelectorAll('[data-slide]'));
    const dots = Array.from(root.querySelectorAll('[data-dot]'));
    const titleEl = root.querySelector('[data-carousel-title]');
    const titles = [
      'Control · Panel general',
      'Control · Reportes y trazabilidad',
      'Control · Cumplimiento SENCE',
      'Campus · Cohorte y personas',
    ];
    if (slides.length === 0) return;

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let index = 0;
    let timer = null;

    function show(next) {
      index = (next + slides.length) % slides.length;
      slides.forEach((slide, i) => {
        const active = i === index;
        slide.classList.toggle('opacity-0', !active);
        slide.classList.toggle('pointer-events-none', !active);
        slide.classList.toggle('opacity-100', active);
        slide.setAttribute('aria-hidden', String(!active));
      });
      dots.forEach((dot, i) => {
        const active = i === index;
        const visual = dot.querySelector('[data-dot-visual]');
        dot.setAttribute('aria-selected', String(active));
        visual?.classList.toggle('w-6', active);
        visual?.classList.toggle('bg-accent-600', active);
        visual?.classList.toggle('w-2', !active);
        visual?.classList.toggle('bg-ink-300', !active);
      });
      if (titleEl) titleEl.textContent = titles[index];
    }

    function start() {
      if (reduce || timer) return;
      timer = window.setInterval(() => show(index + 1), 4500);
    }
    function stop() {
      if (timer) {
        clearInterval(timer);
        timer = null;
      }
    }

    dots.forEach((dot, i) => {
      dot.addEventListener('click', () => {
        show(i);
        stop();
        start();
      });
    });

    root.addEventListener('mouseenter', stop);
    root.addEventListener('mouseleave', start);
    root.addEventListener('focusin', stop);
    root.addEventListener('focusout', start);

    show(0);
    start();
  })();
</script>
