---
import Icon from './Icon.astro';
import { contactForm, whatsapp } from '../content/copy';

// Endpoint del formulario, resuelto en build time desde la variable de entorno.
// Vacío = envío simulado (modo desarrollo). Ver README y .env.example.
const formEndpoint = import.meta.env.PUBLIC_FORM_ENDPOINT ?? '';
// Sheet de scoring de leads (apps-script/README.md). Envío paralelo y silencioso: no bloquea el formulario si falla.
const leadsEndpoint = import.meta.env.PUBLIC_LEADS_ENDPOINT ?? '';
const meetingsUrl = whatsapp.url;
---

<section
  id="contacto"
  class="relative overflow-hidden bg-gradient-to-t from-accent-100 via-accent-50/70 to-white py-16 sm:py-24"
>
  <div
    class="pointer-events-none absolute -bottom-48 left-1/2 h-[42rem] w-[42rem] -translate-x-1/2 rounded-full bg-accent-200/50 blur-3xl"
    aria-hidden="true"
  >
  </div>
  <div
    class="pointer-events-none absolute -bottom-24 right-[-10%] h-[26rem] w-[26rem] rounded-full bg-accent-100/70 blur-3xl"
    aria-hidden="true"
  >
  </div>

  <div class="relative mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
    <div class="reveal text-center">
      <p class="mb-3 text-sm font-semibold uppercase tracking-wide text-accent-600">
        {contactForm.eyebrow}
      </p>
      <h2 class="text-3xl font-bold tracking-tight text-ink-900 sm:text-4xl">
        {contactForm.title}
      </h2>
      <p class="mt-4 text-lg text-ink-600">{contactForm.description}</p>
      <p class="mt-2 text-sm font-medium text-accent-700">{contactForm.disclaimer}</p>
    </div>

    <div
      id="contact-form-card"
      class="reveal mt-10 rounded-card border border-ink-200 bg-white p-6 shadow-soft sm:p-8"
    >
      <form id="contact-form" novalidate>
        <!-- Honeypot anti-spam: oculto para personas, visible para bots que autocompletan todo.
             clip-path en vez de left:-9999px para no generar overflow horizontal en la página.
             Nombre deliberadamente sin sentido (no "website"/"company"/"url") y atributos
             data-*ignore: nombres comunes hacen que gestores de contraseñas (LastPass,
             1Password, Bitwarden) autorrellenen el campo aunque esté oculto, disparando
             el camino de "bot" y ocultando la agenda tras enviar. -->
        <div
          class="absolute h-px w-px overflow-hidden whitespace-nowrap"
          style="clip-path: inset(50%)"
          aria-hidden="true"
        >
          <label for="hp_check">No completar este campo</label>
          <input
            type="text"
            id="hp_check"
            name="hp_check"
            tabindex="-1"
            autocomplete="off"
            data-lpignore="true"
            data-1p-ignore="true"
            data-bwignore="true"
            data-protonpass-ignore="true"
          />
        </div>

        <!-- Indicador de progreso del wizard (2 pasos): círculos numerados unidos por una línea. -->
        <div class="mb-8 flex items-start justify-center">
          <div class="flex w-24 flex-col items-center gap-1.5">
            <span
              id="step-circle-1"
              class="flex h-9 w-9 items-center justify-center rounded-full bg-accent-600 text-sm font-bold text-white transition-colors"
            >
              1
            </span>
            <span id="step-caption-1" class="text-center text-xs font-medium text-ink-900">
              Tus datos
            </span>
          </div>
          <div class="mt-[1.125rem] h-0.5 w-10 shrink-0 overflow-hidden rounded-full bg-ink-100 sm:w-20">
            <div
              id="step-progress"
              class="h-full w-0 rounded-full bg-accent-600 transition-all duration-500 ease-out"
            >
            </div>
          </div>
          <div class="flex w-24 flex-col items-center gap-1.5">
            <span
              id="step-circle-2"
              class="flex h-9 w-9 items-center justify-center rounded-full border-2 border-ink-200 bg-white text-sm font-bold text-ink-400 transition-colors"
            >
              2
            </span>
            <span id="step-caption-2" class="text-center text-xs font-medium text-ink-400">
              Tu proyecto
            </span>
          </div>
        </div>

        {/* Paso 1 · Tus datos de contacto */}
        <div data-step-panel="1" class="grid grid-cols-1 gap-5 sm:grid-cols-2">
          <div>
            <label for="name" class="block text-sm font-medium text-ink-700">Nombre y apellido *</label>
            <input
              type="text"
              id="name"
              name="name"
              required
              autocomplete="name"
              class="mt-1.5 block w-full rounded-lg border border-ink-200 px-3.5 py-2.5 text-ink-900 placeholder:text-ink-400 focus:border-accent-500 focus:outline-none focus:ring-2 focus:ring-accent-200"
              aria-describedby="name-error"
            />
            <p id="name-error" class="mt-1 hidden text-sm text-red-600" role="alert"></p>
          </div>

          <div>
            <label for="email" class="block text-sm font-medium text-ink-700">
              Correo corporativo *
            </label>
            <input
              type="email"
              id="email"
              name="email"
              required
              autocomplete="email"
              class="mt-1.5 block w-full rounded-lg border border-ink-200 px-3.5 py-2.5 text-ink-900 placeholder:text-ink-400 focus:border-accent-500 focus:outline-none focus:ring-2 focus:ring-accent-200"
              aria-describedby="email-error"
            />
            <p id="email-error" class="mt-1 hidden text-sm text-red-600" role="alert"></p>
          </div>

          <div>
            <label for="phone" class="block text-sm font-medium text-ink-700">
              Teléfono / WhatsApp *
            </label>
            <div class="mt-1.5 flex rounded-lg border border-ink-200 bg-white focus-within:border-accent-500 focus-within:ring-2 focus-within:ring-accent-200">
              <span class="flex items-center rounded-l-lg border-r border-ink-200 bg-ink-50 px-3 text-sm font-medium text-ink-600">
                +56
              </span>
              <input
                type="tel"
                id="phone"
                name="phone"
                required
                inputmode="tel"
                autocomplete="tel-national"
                placeholder="9 1234 5678"
                class="block w-full rounded-r-lg border-0 bg-transparent px-3.5 py-2.5 text-ink-900 placeholder:text-ink-400 focus:outline-none focus:ring-0"
                aria-describedby="phone-error"
              />
            </div>
            <p id="phone-error" class="mt-1 hidden text-sm text-red-600" role="alert"></p>
          </div>

          <div>
            <label for="otec" class="block text-sm font-medium text-ink-700">
              Nombre de la OTEC *
            </label>
            <input
              type="text"
              id="otec"
              name="otec"
              required
              autocomplete="organization"
              class="mt-1.5 block w-full rounded-lg border border-ink-200 px-3.5 py-2.5 text-ink-900 placeholder:text-ink-400 focus:border-accent-500 focus:outline-none focus:ring-2 focus:ring-accent-200"
              aria-describedby="otec-error"
            />
            <p id="otec-error" class="mt-1 hidden text-sm text-red-600" role="alert"></p>
          </div>

          <div>
            <label for="cursos_anio" class="block text-sm font-medium text-ink-700">
              Cursos que dictas al año *
            </label>
            <div class="relative mt-1.5">
              <select
                id="cursos_anio"
                name="cursos_anio"
                required
                class="block w-full appearance-none rounded-lg border border-ink-200 bg-white px-3.5 py-2.5 pr-10 text-ink-900 focus:border-accent-500 focus:outline-none focus:ring-2 focus:ring-accent-200"
                aria-describedby="cursos_anio-error"
              >
                {
                  contactForm.cursosOptions.map((option) => (
                    <option value={option.value}>{option.label}</option>
                  ))
                }
              </select>
              <Icon
                name="chevron-down"
                class="pointer-events-none absolute right-3.5 top-1/2 h-4 w-4 -translate-y-1/2 text-ink-400"
              />
            </div>
            <p id="cursos_anio-error" class="mt-1 hidden text-sm text-red-600" role="alert"></p>
          </div>

          <div>
            <label for="personas_anio" class="block text-sm font-medium text-ink-700">
              Personas que capacitas al año *
            </label>
            <div class="relative mt-1.5">
              <select
                id="personas_anio"
                name="personas_anio"
                required
                class="block w-full appearance-none rounded-lg border border-ink-200 bg-white px-3.5 py-2.5 pr-10 text-ink-900 focus:border-accent-500 focus:outline-none focus:ring-2 focus:ring-accent-200"
                aria-describedby="personas_anio-error"
              >
                {
                  contactForm.personasOptions.map((option) => (
                    <option value={option.value}>{option.label}</option>
                  ))
                }
              </select>
              <Icon
                name="chevron-down"
                class="pointer-events-none absolute right-3.5 top-1/2 h-4 w-4 -translate-y-1/2 text-ink-400"
              />
            </div>
            <p id="personas_anio-error" class="mt-1 hidden text-sm text-red-600" role="alert"></p>
          </div>
        </div>

        {/* Paso 2 · Tu proyecto (oculto hasta avanzar).
            Grid a 2 columnas desde md (768px); min-h en las etiquetas de esta fila evita que
            una etiqueta de dos líneas desalinee el select de la columna vecina. */}
        <div data-step-panel="2" class="hidden grid grid-cols-1 gap-5 md:grid-cols-2">
          <div>
            <label for="problema_principal" class="block text-sm font-medium text-ink-700">
              ¿Qué problema quieres resolver primero? *
            </label>
            <div class="relative mt-1.5">
              <select
                id="problema_principal"
                name="problema_principal"
                required
                class="block w-full appearance-none rounded-lg border border-ink-200 bg-white px-3.5 py-2.5 pr-10 text-ink-900 focus:border-accent-500 focus:outline-none focus:ring-2 focus:ring-accent-200"
                aria-describedby="problema_principal-error"
              >
                {
                  contactForm.problemaOptions.map((option) => (
                    <option value={option.value}>{option.label}</option>
                  ))
                }
              </select>
              <Icon
                name="chevron-down"
                class="pointer-events-none absolute right-3.5 top-1/2 h-4 w-4 -translate-y-1/2 text-ink-400"
              />
            </div>
            <p id="problema_principal-error" class="mt-1 hidden text-sm text-red-600" role="alert"></p>
          </div>

          <div>
            <label for="decisor_compra" class="block text-sm font-medium text-ink-700">
              ¿Quién decide la compra en tu OTEC? *
            </label>
            <div class="relative mt-1.5">
              <select
                id="decisor_compra"
                name="decisor_compra"
                required
                class="block w-full appearance-none rounded-lg border border-ink-200 bg-white px-3.5 py-2.5 pr-10 text-ink-900 focus:border-accent-500 focus:outline-none focus:ring-2 focus:ring-accent-200"
                aria-describedby="decisor_compra-error"
              >
                {
                  contactForm.decisorOptions.map((option) => (
                    <option value={option.value}>{option.label}</option>
                  ))
                }
              </select>
              <Icon
                name="chevron-down"
                class="pointer-events-none absolute right-3.5 top-1/2 h-4 w-4 -translate-y-1/2 text-ink-400"
              />
            </div>
            <p id="decisor_compra-error" class="mt-1 hidden text-sm text-red-600" role="alert"></p>
          </div>

          <div>
            <label for="presupuesto" class="block text-sm font-medium text-ink-700">
              Presupuesto mensual contemplado *
            </label>
            <div class="relative mt-1.5">
              <select
                id="presupuesto"
                name="presupuesto"
                required
                class="block w-full appearance-none rounded-lg border border-ink-200 bg-white px-3.5 py-2.5 pr-10 text-ink-900 focus:border-accent-500 focus:outline-none focus:ring-2 focus:ring-accent-200"
                aria-describedby="presupuesto-error"
              >
                {
                  contactForm.presupuestoOptions.map((option) => (
                    <option value={option.value}>{option.label}</option>
                  ))
                }
              </select>
              <Icon
                name="chevron-down"
                class="pointer-events-none absolute right-3.5 top-1/2 h-4 w-4 -translate-y-1/2 text-ink-400"
              />
            </div>
            <p id="presupuesto-error" class="mt-1 hidden text-sm text-red-600" role="alert"></p>
          </div>

          <div>
            <label for="inicio_estimado" class="block text-sm font-medium text-ink-700">
              ¿Cuándo te gustaría comenzar? *
            </label>
            <div class="relative mt-1.5">
              <select
                id="inicio_estimado"
                name="inicio_estimado"
                required
                class="block w-full appearance-none rounded-lg border border-ink-200 bg-white px-3.5 py-2.5 pr-10 text-ink-900 focus:border-accent-500 focus:outline-none focus:ring-2 focus:ring-accent-200"
                aria-describedby="inicio_estimado-error"
              >
                {
                  contactForm.inicioOptions.map((option) => (
                    <option value={option.value}>{option.label}</option>
                  ))
                }
              </select>
              <Icon
                name="chevron-down"
                class="pointer-events-none absolute right-3.5 top-1/2 h-4 w-4 -translate-y-1/2 text-ink-400"
              />
            </div>
            <p id="inicio_estimado-error" class="mt-1 hidden text-sm text-red-600" role="alert"></p>
          </div>

          <div class="md:col-span-2">
            <label for="message" class="block text-sm font-medium text-ink-700">
              Mensaje (opcional)
            </label>
            <textarea
              id="message"
              name="message"
              rows="3"
              class="mt-1.5 block w-full rounded-lg border border-ink-200 px-3.5 py-2.5 text-ink-900 placeholder:text-ink-400 focus:border-accent-500 focus:outline-none focus:ring-2 focus:ring-accent-200"
            ></textarea>
          </div>

          <div class="md:col-span-2">
            <label class="flex cursor-pointer items-start gap-2.5">
              <input
                type="checkbox"
                id="dnc_realizado"
                name="dnc_realizado"
                class="mt-0.5 h-4 w-4 shrink-0 rounded border-ink-300 text-accent-600 focus:ring-2 focus:ring-accent-200"
              />
              <span class="text-sm text-ink-700">{contactForm.dncLabel}</span>
            </label>
          </div>
        </div>

        <div
          id="form-banner"
          class="mt-5 hidden rounded-lg px-4 py-3 text-sm"
          role="status"
          aria-live="polite"
        >
        </div>

        {/* Paso 1: acción "Siguiente" */}
        <div id="step1-actions" class="mt-6 flex justify-end">
          <button
            type="button"
            id="step1-next"
            class="inline-flex items-center justify-center gap-2 rounded-full bg-accent-600 px-6 py-3.5 text-base font-semibold text-white shadow-soft transition-colors hover:bg-accent-700"
          >
            Siguiente
            <Icon name="arrow-right" class="h-5 w-5" />
          </button>
        </div>

        {/* Paso 2: acciones "Atrás" + enviar (oculto hasta avanzar).
            flex-col-reverse en móvil deja "Agenda un diagnóstico" arriba y "Atrás" abajo,
            sin cambiar el orden del DOM (Atrás primero) que sí se usa en ≥768px (fila normal). */}
        <div id="step2-actions" class="mt-6 hidden flex flex-col-reverse gap-3 md:flex-row md:items-center md:justify-between">
          <button
            type="button"
            id="step2-back"
            class="inline-flex w-full items-center justify-center gap-2 rounded-full border border-ink-200 bg-white px-5 py-3.5 text-sm font-semibold text-ink-700 transition-colors hover:border-ink-300 md:w-auto"
          >
            <Icon name="arrow-right" class="h-4 w-4 rotate-180" />
            Atrás
          </button>
          <button
            type="submit"
            id="submit-button"
            data-track="form_submit"
            class="inline-flex w-full items-center justify-center gap-2 rounded-full bg-accent-600 px-6 py-3.5 text-base font-semibold text-white shadow-soft transition-colors hover:bg-accent-700 disabled:cursor-not-allowed disabled:opacity-60 md:w-auto"
          >
            <span id="submit-label">{contactForm.submitLabel}</span>
          </button>
        </div>
      </form>

      {/* Agenda incrustada: se muestra al enviar el formulario (prellenada). */}
      <div id="meetings-embed" class="hidden">
        <div class="mb-5 text-center">
          <p class="text-sm font-semibold uppercase tracking-wide text-accent-600">¡Gracias!</p>
          <p class="mt-1 text-xl font-bold text-ink-900">Elige un horario con César</p>
          <p class="mt-1 text-sm text-ink-500">Agenda de 1 hora, sin costo y sin compromiso.</p>
        </div>
        <div id="meetings-slot" class="min-h-[640px]"></div>
      </div>
    </div>
  </div>

  {/* Toast de éxito: confirma el envío mientras carga el iframe de agendamiento. */}
  <div
    id="success-toast"
    class="pointer-events-none fixed inset-x-4 bottom-5 z-50 flex translate-y-2 justify-center opacity-0 transition-all duration-300 sm:inset-x-auto sm:right-5 sm:justify-end"
    role="status"
    aria-live="polite"
  >
    <div class="pointer-events-auto flex max-w-sm items-center gap-3 rounded-xl bg-accent-600 px-4 py-3.5 text-sm font-medium text-white shadow-lg">
      <span class="flex h-5 w-5 flex-shrink-0 items-center justify-center rounded-full bg-white/20">
        <Icon name="check" class="h-3.5 w-3.5" />
      </span>
      <span id="success-toast-text"></span>
    </div>
  </div>
</section>

<script
  define:vars={{
    states: contactForm.states,
    FORM_ENDPOINT: formEndpoint,
    LEADS_ENDPOINT: leadsEndpoint,
    delivery: contactForm.delivery,
    MEETINGS_URL: meetingsUrl,
  }}
>
  (function () {
    const form = document.getElementById('contact-form');
    const banner = document.getElementById('form-banner');
    const submitButton = document.getElementById('submit-button');
    const submitLabel = document.getElementById('submit-label');
    if (!form || !banner || !submitButton || !submitLabel) return;

    const originalLabel = submitLabel.textContent;

    // Atribución UTM de la visita (para el Sheet de scoring de leads).
    const urlParams = new URLSearchParams(window.location.search);
    const utm = {
      utm_source: urlParams.get('utm_source') || '',
      utm_medium: urlParams.get('utm_medium') || '',
      utm_campaign: urlParams.get('utm_campaign') || '',
    };

    const fields = {
      name: { el: document.getElementById('name'), errorEl: document.getElementById('name-error') },
      email: { el: document.getElementById('email'), errorEl: document.getElementById('email-error') },
      phone: { el: document.getElementById('phone'), errorEl: document.getElementById('phone-error') },
      otec: { el: document.getElementById('otec'), errorEl: document.getElementById('otec-error') },
      cursos_anio: {
        el: document.getElementById('cursos_anio'),
        errorEl: document.getElementById('cursos_anio-error'),
      },
      personas_anio: {
        el: document.getElementById('personas_anio'),
        errorEl: document.getElementById('personas_anio-error'),
      },
      problema_principal: {
        el: document.getElementById('problema_principal'),
        errorEl: document.getElementById('problema_principal-error'),
      },
      presupuesto: {
        el: document.getElementById('presupuesto'),
        errorEl: document.getElementById('presupuesto-error'),
      },
      inicio_estimado: {
        el: document.getElementById('inicio_estimado'),
        errorEl: document.getElementById('inicio_estimado-error'),
      },
      decisor_compra: {
        el: document.getElementById('decisor_compra'),
        errorEl: document.getElementById('decisor_compra-error'),
      },
    };

    const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    // El input de teléfono solo contiene el número local; el prefijo +56 es fijo en el UI.
    const PHONE_RE = /^[0-9\s-]{8,}$/;
    const SELECT_KEYS = [
      'cursos_anio',
      'personas_anio',
      'problema_principal',
      'presupuesto',
      'inicio_estimado',
      'decisor_compra',
    ];

    // Texto visible de la opción elegida (ej. "SENCE..."), en vez del código interno
    // del <option value>, para que el correo y el Sheet muestren la descripción completa.
    function selectedLabel_(el) {
      return el?.selectedOptions?.[0]?.text || el?.value || '';
    }

    function setFieldError(field, message) {
      field.el.classList.toggle('border-red-400', Boolean(message));
      field.el.setAttribute('aria-invalid', message ? 'true' : 'false');
      field.errorEl.textContent = message || '';
      field.errorEl.classList.toggle('hidden', !message);
    }

    const TEXT_VALIDATORS = {
      name: () => {
        if (!fields.name.el.value.trim()) {
          setFieldError(fields.name, 'Ingresa tu nombre.');
          return false;
        }
        setFieldError(fields.name, '');
        return true;
      },
      email: () => {
        if (!EMAIL_RE.test(fields.email.el.value.trim())) {
          setFieldError(fields.email, 'Ingresa un correo válido.');
          return false;
        }
        setFieldError(fields.email, '');
        return true;
      },
      phone: () => {
        if (!PHONE_RE.test(fields.phone.el.value.trim())) {
          setFieldError(fields.phone, 'Ingresa un teléfono válido.');
          return false;
        }
        setFieldError(fields.phone, '');
        return true;
      },
      otec: () => {
        if (!fields.otec.el.value.trim()) {
          setFieldError(fields.otec, 'Ingresa el nombre de tu OTEC.');
          return false;
        }
        setFieldError(fields.otec, '');
        return true;
      },
    };

    function validateSelect(key) {
      const field = fields[key];
      if (!field.el.value) {
        setFieldError(field, 'Selecciona una opción.');
        return false;
      }
      setFieldError(field, '');
      return true;
    }

    function validateKey(key) {
      if (TEXT_VALIDATORS[key]) return TEXT_VALIDATORS[key]();
      if (SELECT_KEYS.includes(key)) return validateSelect(key);
      return true;
    }

    const STEP1_KEYS = ['name', 'email', 'phone', 'otec', 'cursos_anio', 'personas_anio'];
    const STEP2_KEYS = ['problema_principal', 'presupuesto', 'inicio_estimado', 'decisor_compra'];

    function validateKeys(keys) {
      let valid = true;
      keys.forEach((key) => {
        if (!validateKey(key)) valid = false;
      });
      return valid;
    }

    function validate() {
      return validateKeys(STEP1_KEYS.concat(STEP2_KEYS));
    }

    // --- Wizard de 2 pasos ---
    const step1Panel = document.querySelector('[data-step-panel="1"]');
    const step2Panel = document.querySelector('[data-step-panel="2"]');
    const step1Actions = document.getElementById('step1-actions');
    const step2Actions = document.getElementById('step2-actions');
    const step1NextBtn = document.getElementById('step1-next');
    const step2BackBtn = document.getElementById('step2-back');
    const stepProgress = document.getElementById('step-progress');
    const stepCircle2 = document.getElementById('step-circle-2');
    const stepCaption2 = document.getElementById('step-caption-2');
    const formCard = document.getElementById('contact-form-card');

    function goToStep(step) {
      const isStep1 = step === 1;
      step1Panel?.classList.toggle('hidden', !isStep1);
      step2Panel?.classList.toggle('hidden', isStep1);
      step1Actions?.classList.toggle('hidden', !isStep1);
      step2Actions?.classList.toggle('hidden', isStep1);
      if (stepProgress) stepProgress.style.width = isStep1 ? '0%' : '100%';
      // El círculo 1 queda siempre resuelto (ya se pasó o se está completando);
      // solo el círculo 2 alterna entre pendiente (contorno) y activo (relleno).
      stepCircle2?.classList.toggle('bg-accent-600', !isStep1);
      stepCircle2?.classList.toggle('border-accent-600', !isStep1);
      stepCircle2?.classList.toggle('text-white', !isStep1);
      stepCircle2?.classList.toggle('border-2', isStep1);
      stepCircle2?.classList.toggle('border-ink-200', isStep1);
      stepCircle2?.classList.toggle('bg-white', isStep1);
      stepCircle2?.classList.toggle('text-ink-400', isStep1);
      stepCaption2?.classList.toggle('text-ink-900', !isStep1);
      stepCaption2?.classList.toggle('text-ink-400', isStep1);
      banner.classList.add('hidden');
      formCard?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    step1NextBtn?.addEventListener('click', () => {
      if (validateKeys(STEP1_KEYS)) {
        goToStep(2);
      } else {
        step1Panel?.querySelector('[aria-invalid="true"]')?.focus();
      }
    });

    step2BackBtn?.addEventListener('click', () => goToStep(1));

    const toast = document.getElementById('success-toast');
    const toastText = document.getElementById('success-toast-text');
    let toastHideTimer = null;

    function showToast(message) {
      if (!toast || !toastText) return;
      clearTimeout(toastHideTimer);
      toastText.textContent = message;
      toast.classList.remove('opacity-0', 'translate-y-2');
      // Cierre automático de respaldo, por si el iframe nunca llega a cargar.
      toastHideTimer = setTimeout(hideToast, 8000);
    }

    function hideToast() {
      if (!toast) return;
      clearTimeout(toastHideTimer);
      toast.classList.add('opacity-0', 'translate-y-2');
    }

    function showBanner(kind, message) {
      banner.textContent = message;
      banner.classList.remove('hidden', 'bg-red-50', 'text-red-700', 'bg-accent-50', 'text-accent-700');
      if (kind === 'success') {
        banner.classList.add('bg-accent-50', 'text-accent-700');
      } else {
        banner.classList.add('bg-red-50', 'text-red-700');
      }
    }

    function setLoading(isLoading) {
      submitButton.disabled = isLoading;
      submitLabel.textContent = isLoading ? states.loading : originalLabel;
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      banner.classList.add('hidden');

      // Honeypot: si un bot completó este campo, se descarta el envío en silencio.
      const honeypot = document.getElementById('hp_check');
      if (honeypot && honeypot.value.trim()) {
        showBanner('success', states.success);
        form.reset();
        return;
      }

      if (!validate()) {
        const step1HasError = STEP1_KEYS.some((key) => fields[key].el.getAttribute('aria-invalid') === 'true');
        if (step1HasError) goToStep(1);
        return;
      }

      const payload = {
        name: fields.name.el.value.trim(),
        email: fields.email.el.value.trim(),
        phone: `+56 ${fields.phone.el.value.trim()}`,
        otec: fields.otec.el.value.trim(),
        cursos_anio: selectedLabel_(fields.cursos_anio.el),
        personas_anio: selectedLabel_(fields.personas_anio.el),
        problema_principal: selectedLabel_(fields.problema_principal.el),
        presupuesto: selectedLabel_(fields.presupuesto.el),
        inicio_estimado: selectedLabel_(fields.inicio_estimado.el),
        decisor_compra: selectedLabel_(fields.decisor_compra.el),
        message: document.getElementById('message').value.trim(),
        dnc_realizado: document.getElementById('dnc_realizado').checked ? 'Sí' : 'No',
        source: 'landing-certimedia',
        ...utm,
        // Campos de control de FormSubmit (ignorados por otros endpoints).
        _cc: delivery.cc,
        _subject: delivery.subject,
        _template: 'table',
        _captcha: 'false',
      };

      // Registro en el Sheet de scoring de leads: en paralelo, silencioso, no bloquea el envío principal.
      if (LEADS_ENDPOINT) {
        fetch(LEADS_ENDPOINT, { method: 'POST', mode: 'no-cors', body: JSON.stringify(payload) }).catch((error) => {
          console.warn('[contact-form] No se pudo registrar el lead en el Sheet de scoring.', error);
        });
      }

      setLoading(true);

      try {
        if (!FORM_ENDPOINT) {
          // Sin endpoint configurado: simulamos un envío exitoso (modo desarrollo).
          await new Promise((resolve) => setTimeout(resolve, 600));
          console.info('[contact-form] PUBLIC_FORM_ENDPOINT no configurado: envío simulado.', payload);
        } else {
          const response = await fetch(FORM_ENDPOINT, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });
          if (!response.ok) {
            throw new Error(`Respuesta no válida del servidor (${response.status})`);
          }
        }

        window.trackEvent?.('form_submit_success', { form: 'contacto' });
        showToast(states.success);
        showMeetings(payload.name, payload.email);
      } catch (error) {
        console.error('[contact-form] Error al enviar el formulario', error);
        showBanner('error', states.error);
        window.trackEvent?.('form_submit_error', { form: 'contacto' });
      } finally {
        setLoading(false);
      }
    });

    // Muestra la agenda de HubSpot incrustada (prellenada) tras enviar el formulario.
    function showMeetings(name, email) {
      const wrap = document.getElementById('meetings-embed');
      const slot = document.getElementById('meetings-slot');
      if (!wrap || !slot || !MEETINGS_URL) {
        showBanner('success', states.success);
        hideToast();
        return;
      }
      const params = new URLSearchParams({ embed: 'true' });
      if (email) params.set('email', email);
      if (name) params.set('firstName', name);

      // El toast de éxito ya está visible; se oculta cuando el iframe termina de cargar
      // (con un mínimo de tiempo en pantalla para que no desaparezca de golpe).
      const toastShownAt = Date.now();
      const dismissToastAfterLoad = () => {
        const elapsed = Date.now() - toastShownAt;
        setTimeout(hideToast, Math.max(0, 1200 - elapsed));
      };

      const iframe = document.createElement('iframe');
      iframe.src = `${MEETINGS_URL}?${params.toString()}`;
      iframe.title = 'Agenda una reunión con César';
      iframe.loading = 'lazy';
      iframe.style.width = '100%';
      iframe.style.minHeight = '700px';
      iframe.style.border = '0';
      iframe.addEventListener('load', dismissToastAfterLoad);
      slot.innerHTML = '';
      slot.appendChild(iframe);

      form.classList.add('hidden');
      wrap.classList.remove('hidden');
      wrap.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  })();
</script>
