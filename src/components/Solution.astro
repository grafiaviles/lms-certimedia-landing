---
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
import { solution } from '../content/copy';
---

<section id="solucion" class="bg-white py-16 sm:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <SectionHeading eyebrow={solution.eyebrow} title={solution.title} />

    <div class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-3">
      {
        solution.blocks.map((block, i) => (
          <div
            class="reveal rounded-card border border-ink-200 p-6"
            style={`transition-delay: ${i * 80}ms`}
          >
            <div class="mb-5 flex h-28 items-center justify-center rounded-xl bg-accent-50">
              <Icon name={block.icon} class="h-12 w-12 text-accent-600" />
            </div>
            <h3 class="text-lg font-semibold text-ink-900">{block.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-600">{block.description}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
