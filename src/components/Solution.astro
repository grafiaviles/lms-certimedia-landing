---
import Icon from './Icon.astro';
import Illustration from './Illustration.astro';
import Avatar from './Avatar.astro';
import SectionHeading from './SectionHeading.astro';
import RoadmapBadge from './RoadmapBadge.astro';
import { solution } from '../content/copy';
import { asset } from '../lib/asset';
import { demoFloatingCards, demoStatCards, demoPeopleChips } from '../content/demoData';

// Clave de datos de ejemplo por bloque ('Campus' -> 'campus', 'Control' -> 'control').
const demoKey = (app: string) => app.toLowerCase();

// Los placeholders de captura solo se muestran en desarrollo.
const showPlaceholders = import.meta.env.DEV;
---

<section id="solucion" class="bg-white py-16 sm:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <SectionHeading
      eyebrow={solution.eyebrow}
      title={solution.title}
      description={solution.description}
    />

    <div class="mt-14 flex flex-col gap-16 sm:gap-24">
      {
        solution.blocks.map((block, i) => {
          const flipped = i % 2 === 1;
          const key = demoKey(block.app);
          const floatingCard = demoFloatingCards[key];
          const statCard = demoStatCards[key];
          const peopleChip = demoPeopleChips[key];
          return (
            <div
              class:list={[
                'grid items-center gap-8 lg:gap-16',
                flipped
                  ? 'lg:grid-cols-[minmax(0,1.18fr)_minmax(0,1fr)]'
                  : 'lg:grid-cols-[minmax(0,1fr)_minmax(0,1.18fr)]',
              ]}
            >
              {/* Texto */}
              <div class:list={['reveal', { 'lg:order-2': flipped }]}>
                <h3 class="text-2xl font-bold tracking-tight text-ink-900 sm:text-3xl">
                  {block.app}
                </h3>
                <p class="mt-1 text-sm font-semibold uppercase tracking-wide text-accent-600">
                  {block.tagline}
                </p>
                <p class="mt-3 text-base leading-relaxed text-ink-600">{block.description}</p>

                <ul class="mt-5 space-y-3">
                  {block.bullets.map((point) => {
                    const isRich = typeof point === 'object';
                    const isRoadmap = isRich && point.status === 'roadmap';
                    return (
                      <li class="flex items-start gap-2.5">
                        <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-accent-100 text-accent-700">
                          <Icon name="check" class="h-3.5 w-3.5" />
                        </span>
                        {isRich ? (
                          <span class="text-sm text-ink-700">
                            <span class="flex flex-wrap items-center font-semibold text-ink-900">
                              {point.title}
                              {isRoadmap && <RoadmapBadge />}
                            </span>
                            <span class="leading-relaxed">{point.description}</span>
                          </span>
                        ) : (
                          <span class="text-sm font-medium text-ink-700">{point}</span>
                        )}
                      </li>
                    );
                  })}
                </ul>
              </div>

              {/* Imagen real de la plataforma, en un marco tipo ventana. */}
              <div class:list={['reveal relative', { 'lg:order-1': flipped }]}>
                <figure class="overflow-hidden rounded-card border border-ink-200 bg-white shadow-soft">
                  <div class="flex items-center gap-1.5 border-b border-ink-100 bg-ink-50 px-4 py-2.5">
                    <span class="h-2.5 w-2.5 rounded-full bg-ink-300" />
                    <span class="h-2.5 w-2.5 rounded-full bg-ink-300" />
                    <span class="h-2.5 w-2.5 rounded-full bg-ink-300" />
                  </div>

                  <div class="relative bg-white">
                    {/* Placeholder visible solo en desarrollo; en producción no se renderiza. */}
                    {showPlaceholders && (
                      <div
                        class="absolute inset-0 flex flex-col items-center justify-center gap-3 text-center text-ink-400"
                        data-img-placeholder
                      >
                        <Illustration name={block.illustration} class="h-20 w-20" />
                        <p class="px-6 text-xs font-medium">
                          Captura de la plataforma
                          <br />
                          <span class="text-ink-300">(pendiente de subir)</span>
                        </p>
                      </div>
                    )}

                    <img
                      src={asset(block.image)}
                      alt={block.imageAlt}
                      width={block.imageWidth}
                      height={block.imageHeight}
                      loading="lazy"
                      decoding="async"
                      class="block h-auto w-full opacity-0 transition-opacity duration-500"
                      data-platform-img
                    />
                  </div>
                </figure>

                {/* Tarjeta superpuesta (abajo, lado interno). */}
                <div
                  class:list={[
                    'absolute bottom-[-24px] z-20 hidden items-start gap-3 rounded-xl border border-ink-100 bg-white p-3.5 shadow-soft sm:flex',
                    flipped ? 'right-10' : 'left-10',
                  ]}
                >
                  <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-accent-600 text-white">
                    <Icon name={block.floatingCardIcon} class="h-5 w-5" />
                  </span>
                  <div>
                    <p class="text-[10px] font-semibold uppercase tracking-wide text-accent-600">
                      {floatingCard.scope}
                    </p>
                    <p class="text-sm font-semibold text-ink-900">{floatingCard.title}</p>
                    <p class="text-xs text-ink-500">{floatingCard.subtitle}</p>
                  </div>
                </div>

                {/* Chip de avatares (arriba, lado externo). */}
                <div
                  class:list={[
                    'absolute top-[-22px] z-20 hidden items-center gap-2 rounded-full border border-ink-100 bg-white py-1.5 pl-2 pr-4 shadow-soft sm:flex',
                    flipped ? 'left-8' : 'right-8',
                  ]}
                >
                  <div class="flex -space-x-2">
                    {block.peopleVariants.map((v) => (
                      <Avatar variant={v} class="h-7 w-7 rounded-full ring-2 ring-white" />
                    ))}
                  </div>
                  <span class="text-xs font-semibold text-ink-700">{peopleChip.label}</span>
                </div>

                {/* Mini stat flotante (abajo, lado externo). */}
                <div
                  class:list={[
                    'absolute bottom-[-24px] z-20 hidden items-center gap-3 rounded-xl border border-ink-100 bg-white px-4 py-3 shadow-soft lg:flex',
                    flipped ? 'left-8' : 'right-8',
                  ]}
                >
                  <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg bg-accent-50 text-accent-600">
                    <Icon name={block.statCardIcon} class="h-6 w-6" />
                  </span>
                  <div>
                    <p class="text-xs text-ink-500">{statCard.label}</p>
                    <p class="text-xl font-bold text-ink-900">{statCard.value}</p>
                  </div>
                </div>
              </div>
            </div>
          );
        })
      }
    </div>
  </div>
</section>

<script>
  // Muestra la imagen solo si carga; si falta el archivo, se mantiene el placeholder.
  (function () {
    document.querySelectorAll('[data-platform-img]').forEach((img) => {
      const reveal = () => {
        img.classList.remove('opacity-0');
        const placeholder = img.parentElement?.querySelector('[data-img-placeholder]');
        placeholder?.classList.add('hidden');
      };
      if (img.complete && img.naturalWidth > 0) reveal();
      else img.addEventListener('load', reveal, { once: true });
      // onerror: no hacemos nada, el placeholder queda visible.
    });
  })();
</script>
