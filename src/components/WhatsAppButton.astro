---
import Icon from './Icon.astro';
import { whatsapp, contactPerson } from '../content/copy';
import { asset } from '../lib/asset';
---

<a
  href="#contacto"
  data-track="cta_agenda"
  aria-label={whatsapp.label}
  class="group fixed bottom-5 right-5 z-50 block focus-visible:outline-none sm:bottom-6 sm:right-6"
>
  <!-- Tooltip "Hablemos": arriba del avatar, visible solo al hacer hover/foco. -->
  <span
    class="pointer-events-none absolute bottom-full right-0 mb-2.5 translate-y-1 whitespace-nowrap rounded-2xl rounded-br-sm bg-white px-3.5 py-2 text-sm font-semibold text-ink-800 opacity-0 shadow-soft ring-1 ring-ink-200/60 transition-all duration-200 group-hover:translate-y-0 group-hover:opacity-100 group-focus-visible:translate-y-0 group-focus-visible:opacity-100"
    role="tooltip"
  >
    {whatsapp.bubble}
  </span>

  <span class="relative block shrink-0">
    <img
      src={asset(contactPerson.avatar)}
      alt={contactPerson.name}
      width="56"
      height="56"
      loading="lazy"
      class="h-14 w-14 rounded-full object-cover shadow-[0_12px_30px_rgba(2,23,67,0.35)] transition-transform group-hover:scale-105"
    />
    <span
      class="absolute -bottom-0.5 -right-0.5 flex h-6 w-6 items-center justify-center rounded-full bg-accent-600 ring-2 ring-white"
      aria-hidden="true"
    >
      <Icon name="calendar" class="h-3.5 w-3.5 text-white" />
    </span>
  </span>
</a>
