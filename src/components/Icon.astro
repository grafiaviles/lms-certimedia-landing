---
// Set de íconos SVG inline, coherentes entre sí (trazo, misma grilla 24x24).
// Sin librerías externas.
interface Props {
  name:
    | 'bell'
    | 'clipboard-check'
    | 'bar-chart'
    | 'settings'
    | 'shield-check'
    | 'award'
    | 'sence'
    | 'dashboard'
    | 'badge'
    | 'check'
    | 'menu'
    | 'close'
    | 'chevron-down'
    | 'mail'
    | 'phone'
    | 'map-pin'
    | 'arrow-right'
    | 'play';
  class?: string;
  id?: string;
}

const { name, class: className = 'h-6 w-6', id } = Astro.props;

const paths: Record<Props['name'], string> = {
  bell: 'M12 3a5 5 0 0 0-5 5v3.4c0 .5-.2 1-.5 1.4L5 15h14l-1.5-2.2a2.3 2.3 0 0 1-.5-1.4V8a5 5 0 0 0-5-5ZM9.5 18a2.5 2.5 0 0 0 5 0',
  'clipboard-check':
    'M9 4.5h6a1 1 0 0 1 1 1V6h1.5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-13a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1H8v-.5a1 1 0 0 1 1-1Zm0 0V6h6v-1.5M9 13l2 2 4-4.5',
  'bar-chart': 'M5 20V10m7 10V4m7 16v-7M3 20h18',
  settings:
    'M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6Zm8.4-3a7.9 7.9 0 0 0-.2-1.8l2-1.5-2-3.4-2.3.9a7.8 7.8 0 0 0-1.6-.9L16 2.5h-4l-.3 2.8a7.8 7.8 0 0 0-1.6.9l-2.3-.9-2 3.4 2 1.5a8 8 0 0 0 0 3.6l-2 1.5 2 3.4 2.3-.9c.5.4 1 .7 1.6.9L12 21.5h4l.3-2.8c.6-.2 1.1-.5 1.6-.9l2.3.9 2-3.4-2-1.5c.1-.6.2-1.2.2-1.8Z',
  'shield-check':
    'M12 3l7 3v5c0 5-3 8.5-7 10-4-1.5-7-5-7-10V6l7-3Zm-3 9 2.2 2.2L15.5 10',
  award:
    'M12 14a5 5 0 1 0 0-10 5 5 0 0 0 0 10Zm-3.2 1.8L7.5 21l4.5-2.5 4.5 2.5-1.3-5.2',
  sence: 'M4 19V8l8-5 8 5v11M9 19v-6h6v6M4 10h16',
  dashboard: 'M4 5h7v6H4V5Zm9 0h7v4h-7V5ZM4 13h7v6H4v-6Zm9 2h7v4h-7v-4Z',
  badge:
    'M12 2 4 6v6c0 5 3.5 8.5 8 10 4.5-1.5 8-5 8-10V6l-8-4Zm-2.5 9.5L12 14l5-5.5',
  check: 'M5 12.5 9.5 17 19 7',
  menu: 'M4 7h16M4 12h16M4 17h16',
  close: 'M6 6l12 12M18 6 6 18',
  'chevron-down': 'M6 9l6 6 6-6',
  mail: 'M4 6h16v12H4V6Zm0 0 8 7 8-7',
  phone:
    'M6.6 10.8a15 15 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.2 11 11 0 0 0 3.1.5 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 5a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1 11 11 0 0 0 .5 3.1 1 1 0 0 1-.2 1l-2.2 2.2Z',
  'map-pin':
    'M12 21s7-6.2 7-11.5A7 7 0 0 0 5 9.5C5 14.8 12 21 12 21Zm0-9a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z',
  'arrow-right': 'M5 12h14M13 6l6 6-6 6',
  play: 'M8 5.5v13l11-6.5-11-6.5Z',
};
---

<svg
  id={id}
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <path d={paths[name]}></path>
</svg>
