---
import Icon from './Icon.astro';
import { credibility } from '../content/copy';

const icons = ['shield-check', 'settings', 'sence', 'bell'] as const;
---

<section class="border-y border-ink-200/70 bg-white py-8" aria-label="Respaldo de la plataforma">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <ul class="grid grid-cols-2 gap-6 text-center sm:grid-cols-4 sm:gap-8">
      {
        credibility.map((item, i) => (
          <li class="flex flex-col items-center gap-2 sm:flex-row sm:justify-center sm:gap-2.5">
            <Icon name={icons[i % icons.length]} class="h-5 w-5 shrink-0 text-accent-600" />
            <span class="text-sm font-medium text-ink-600">{item}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>
