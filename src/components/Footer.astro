---
import Icon from './Icon.astro';
import { site, nav, footer } from '../content/copy';
import { asset } from '../lib/asset';

const year = new Date().getFullYear();
---

<footer class="bg-ink-900 py-12 text-ink-300">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col gap-10 sm:flex-row sm:justify-between">
      <div class="max-w-sm">
        <img src={asset(nav.logo.src)} alt={nav.logo.alt} width="130" height="27" class="h-7 w-auto brightness-0 invert" />
        <p class="mt-4 text-sm leading-relaxed text-ink-400">{footer.description}</p>
        <a
          href={footer.cta.href}
          data-track="cta_footer"
          class="mt-5 inline-flex items-center justify-center gap-2 rounded-full bg-accent-600 px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-accent-500"
        >
          {footer.cta.label}
          <Icon name="arrow-right" class="h-4 w-4" />
        </a>
      </div>

      <div class="text-sm">
        <p class="font-semibold text-white">Contacto</p>
        <ul class="mt-4 space-y-3 text-ink-400">
          <li class="flex items-center gap-2.5">
            <Icon name="mail" class="h-4 w-4 shrink-0 text-accent-400" />
            <a href={`mailto:${site.email}`} class="hover:text-white">{site.email}</a>
          </li>
          <li class="flex items-center gap-2.5">
            <Icon name="phone" class="h-4 w-4 shrink-0 text-accent-400" />
            <a href={`tel:${site.phoneHref}`} class="hover:text-white">{site.phone}</a>
          </li>
          <li class="flex items-center gap-2.5">
            <Icon name="map-pin" class="h-4 w-4 shrink-0 text-accent-400" />
            <span>{site.address}</span>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-10 border-t border-ink-700 pt-6 text-xs text-ink-500">
      <p>&copy; {year} {site.company}. Todos los derechos reservados.</p>
    </div>
  </div>
</footer>
