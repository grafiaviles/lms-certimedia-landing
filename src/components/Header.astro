---
import Icon from './Icon.astro';
import { nav } from '../content/copy';
import { asset } from '../lib/asset';
---

<header
  class="fixed inset-x-0 top-0 z-50 border-b border-ink-200/70 bg-white/90 backdrop-blur-sm"
>
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-4 px-4 sm:px-6 lg:px-8">
    <a href="#top" class="flex shrink-0 items-center" aria-label={`${nav.logo.alt}, inicio`}>
      <img
        src={asset(nav.logo.src)}
        alt={nav.logo.alt}
        width={nav.logo.width}
        height={nav.logo.height}
        class="h-7 w-auto sm:h-8"
      />
    </a>

    <nav class="hidden items-center gap-8 md:flex" aria-label="Navegación principal">
      {
        nav.links.map((link) => (
          <a
            href={link.href}
            class="text-sm font-medium text-ink-600 transition-colors hover:text-accent-700"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="hidden md:block">
      <a
        href="#contacto"
        data-track="cta_header"
        class="inline-flex items-center justify-center rounded-full bg-accent-600 px-5 py-2.5 text-sm font-semibold text-white shadow-softer transition-colors hover:bg-accent-700"
      >
        {nav.cta}
      </a>
    </div>

    <button
      type="button"
      id="mobile-menu-button"
      class="inline-flex items-center justify-center rounded-lg p-2 text-ink-700 md:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Abrir menú de navegación"
    >
      <Icon name="menu" class="h-6 w-6" id="menu-icon-open" />
      <Icon name="close" class="hidden h-6 w-6" id="menu-icon-close" />
    </button>
  </div>

  <nav
    id="mobile-menu"
    class="hidden border-t border-ink-200/70 bg-white px-4 pb-4 pt-2 md:hidden"
    aria-label="Navegación móvil"
  >
    <ul class="flex flex-col gap-1">
      {
        nav.links.map((link) => (
          <li>
            <a
              href={link.href}
              class="block rounded-lg px-3 py-2.5 text-base font-medium text-ink-700 hover:bg-ink-50"
              data-mobile-link
            >
              {link.label}
            </a>
          </li>
        ))
      }
      <li class="pt-2">
        <a
          href="#contacto"
          data-track="cta_header_mobile"
          data-mobile-link
          class="block rounded-full bg-accent-600 px-4 py-3 text-center text-base font-semibold text-white hover:bg-accent-700"
        >
          {nav.cta}
        </a>
      </li>
    </ul>
  </nav>
</header>

<script is:inline>
  (function () {
    const button = document.getElementById('mobile-menu-button');
    const menu = document.getElementById('mobile-menu');
    const iconOpen = document.getElementById('menu-icon-open');
    const iconClose = document.getElementById('menu-icon-close');
    if (!button || !menu) return;

    function closeMenu() {
      menu.classList.add('hidden');
      button.setAttribute('aria-expanded', 'false');
      iconOpen?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
    }

    function openMenu() {
      menu.classList.remove('hidden');
      button.setAttribute('aria-expanded', 'true');
      iconOpen?.classList.add('hidden');
      iconClose?.classList.remove('hidden');
    }

    button.addEventListener('click', () => {
      const isOpen = button.getAttribute('aria-expanded') === 'true';
      isOpen ? closeMenu() : openMenu();
    });

    menu.querySelectorAll('[data-mobile-link]').forEach((link) => {
      link.addEventListener('click', closeMenu);
    });
  })();
</script>
