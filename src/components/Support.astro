---
import SectionHeading from './SectionHeading.astro';
import Icon from './Icon.astro';
import { support } from '../content/copy';
---

<section class="bg-ink-50 py-16 sm:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <SectionHeading eyebrow={support.eyebrow} title={support.title} />

    {/* Feed conectado (sin cards): chip elevado + línea, con lift al pasar el mouse. */}
    <div class="relative mt-16 grid grid-cols-1 gap-12 sm:grid-cols-3 sm:gap-8">
      <div
        class="pointer-events-none absolute inset-x-0 top-7 hidden h-px bg-gradient-to-r from-transparent via-ink-200 to-transparent sm:block"
        aria-hidden="true"
      >
      </div>

      {
        support.items.map((item, i) => (
          <div
            class="reveal group relative flex flex-col items-center text-center sm:items-start sm:text-left"
            style={`transition-delay: ${i * 100}ms`}
          >
            <span
              class="absolute left-1/2 top-7 hidden h-2.5 w-2.5 -translate-x-1/2 -translate-y-1/2 rounded-full bg-ink-300 ring-4 ring-ink-50 transition-colors duration-300 group-hover:bg-accent-600 sm:left-7"
              aria-hidden="true"
            />
            <span class="relative z-10 flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl bg-white text-accent-600 shadow-soft ring-1 ring-ink-100 transition-all duration-300 ease-out group-hover:-translate-y-1.5 group-hover:text-white group-hover:shadow-[0_12px_24px_-8px_rgb(var(--accent-600)/0.45)]">
              <span class="absolute inset-0 scale-0 rounded-2xl bg-accent-600 transition-transform duration-300 ease-out group-hover:scale-100" />
              <Icon name={item.icon} class="relative z-10 h-6 w-6" />
            </span>
            <h3 class="mt-5 text-base font-semibold text-ink-900">{item.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-600">{item.description}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
