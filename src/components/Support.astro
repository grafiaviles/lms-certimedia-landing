---
import SectionHeading from './SectionHeading.astro';
import Illustration from './Illustration.astro';
import { support } from '../content/copy';
---

<section class="bg-ink-50 py-16 sm:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <SectionHeading eyebrow={support.eyebrow} title={support.title} />

    <div class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-3">
      {
        support.items.map((item, i) => (
          <div
            class="reveal rounded-card border border-ink-200 bg-white p-6 text-center sm:text-left"
            style={`transition-delay: ${i * 80}ms`}
          >
            <Illustration name={item.illustration} class="mx-auto mb-4 h-20 w-20 sm:mx-0" />
            <h3 class="text-base font-semibold text-ink-900">{item.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-600">{item.description}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
