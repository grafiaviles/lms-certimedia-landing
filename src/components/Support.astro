---
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
import { support } from '../content/copy';

const icons = ['shield-check', 'bell', 'settings'] as const;
---

<section class="bg-ink-50 py-16 sm:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <SectionHeading eyebrow={support.eyebrow} title={support.title} />

    <div class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-3">
      {
        support.items.map((item, i) => (
          <div class="reveal text-center sm:text-left" style={`transition-delay: ${i * 80}ms`}>
            <div class="mx-auto mb-4 flex h-11 w-11 items-center justify-center rounded-xl bg-white shadow-softer sm:mx-0">
              <Icon name={icons[i]} class="h-6 w-6 text-accent-600" />
            </div>
            <h3 class="text-base font-semibold text-ink-900">{item.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-600">{item.description}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
