---
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
import { beforeAfter } from '../content/copy';
---

<section class="bg-ink-50 py-16 sm:py-24">
  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
    <SectionHeading eyebrow={beforeAfter.eyebrow} title={beforeAfter.title} />

    <div class="mt-12 space-y-4">
      {
        beforeAfter.rows.map((row, i) => (
          <div
            class="reveal grid grid-cols-1 items-stretch gap-3 sm:grid-cols-[1fr_auto_1fr] sm:gap-4"
            style={`transition-delay: ${Math.min(i, 5) * 60}ms`}
          >
            <div class="flex items-center gap-3 rounded-xl border border-ink-200 bg-white p-4">
              <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-ink-100 text-ink-400">
                <Icon name="close" class="h-4 w-4" />
              </span>
              <p class="text-sm leading-relaxed text-ink-500">{row.before}</p>
            </div>

            <div class="flex items-center justify-center" aria-hidden="true">
              <span class="flex h-8 w-8 items-center justify-center rounded-full bg-accent-100 text-accent-700">
                <Icon name="arrow-right" class="h-4 w-4 rotate-90 sm:rotate-0" />
              </span>
            </div>

            <div class="flex items-center gap-3 rounded-xl border border-accent-200 bg-accent-50 p-4">
              <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-accent-600 text-white">
                <Icon name="check" class="h-4 w-4" />
              </span>
              <p class="text-sm font-medium leading-relaxed text-ink-800">{row.after}</p>
            </div>
          </div>
        ))
      }
    </div>

    <div class="reveal mt-10 text-center">
      <a
        href={beforeAfter.cta.href}
        data-track="cta_antes_despues"
        class="inline-flex items-center justify-center gap-2 rounded-full bg-accent-600 px-6 py-3.5 text-base font-semibold text-white shadow-soft transition-colors hover:bg-accent-700"
      >
        {beforeAfter.cta.label}
        <Icon name="arrow-right" class="h-4 w-4" />
      </a>
    </div>
  </div>
</section>
