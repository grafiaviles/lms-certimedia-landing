---
import { serviceModel } from '../content/copy';

// Dos paneles a todo lo alto con tonos tenues distintos (minimalista, sin cards).
const panelBg = ['bg-ink-50', 'bg-accent-50'];
---

<section id="modelo-servicio">
  <div class="mx-auto max-w-7xl px-4 py-16 text-center sm:px-6 sm:py-20 lg:px-8">
    <p class="mb-3 text-sm font-semibold uppercase tracking-wide text-accent-600">
      {serviceModel.eyebrow}
    </p>
    <h2 class="text-3xl font-bold tracking-tight text-ink-900 sm:text-4xl">{serviceModel.title}</h2>
  </div>

  <div class="grid lg:grid-cols-2">
    {
      serviceModel.options.map((option, i) => (
        <div
          class:list={[
            'flex flex-col justify-center px-6 py-16 sm:px-10 lg:min-h-[30rem] lg:px-16 lg:py-24',
            panelBg[i],
          ]}
        >
          <div class="mx-auto w-full max-w-md lg:mx-0">
            <span class="text-sm font-semibold text-accent-500">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3 class="mt-3 text-3xl font-bold tracking-tight text-ink-900 sm:text-4xl">
              {option.title}
            </h3>
            <p class="mt-5 text-lg leading-relaxed text-ink-600">{option.description}</p>
          </div>
        </div>
      ))
    }
  </div>
</section>
