---
import Icon from './Icon.astro';
import { serviceModel } from '../content/copy';
---

<section id="modelo-servicio" class="bg-white py-16 sm:py-24">
  <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
    <div class="reveal text-center">
      <p class="mb-3 text-sm font-semibold uppercase tracking-wide text-accent-600">
        {serviceModel.eyebrow}
      </p>
      <h2 class="text-3xl font-bold tracking-tight text-ink-900 sm:text-4xl">{serviceModel.title}</h2>
    </div>

    {/* Selector tipo switch: alterna el panel de abajo sin recargar ni navegar. */}
    <div class="reveal mt-8 flex justify-center">
      <div
        id="model-switch"
        role="tablist"
        aria-label="Modelo de servicio"
        class="relative inline-flex rounded-full border border-ink-200 bg-ink-50 p-1"
      >
        <span
          id="model-switch-thumb"
          class="absolute inset-y-1 left-1 w-[calc(50%-4px)] rounded-full bg-accent-600 shadow-soft transition-transform duration-300 ease-out"
          aria-hidden="true"
        ></span>
        {
          serviceModel.options.map((option, i) => (
            <button
              type="button"
              role="tab"
              id={`model-tab-${i}`}
              data-model-tab={i}
              aria-selected={i === 0 ? 'true' : 'false'}
              class="relative z-10 min-w-[9.5rem] rounded-full px-5 py-2.5 text-sm font-semibold text-ink-600 transition-colors duration-300"
            >
              {option.title}
            </button>
          ))
        }
      </div>
    </div>

    {/* Panel con crossfade: icono + tagline + descripción del modelo activo. */}
    <div class="relative mt-10 min-h-[11rem] sm:min-h-[9rem]">
      {
        serviceModel.options.map((option, i) => (
          <div
            data-model-panel={i}
            class:list={[
              'absolute inset-0 flex flex-col items-center gap-4 text-center transition-opacity duration-300 sm:flex-row sm:text-left',
              { 'pointer-events-none opacity-0': i !== 0 },
            ]}
          >
            <span class="flex h-16 w-16 shrink-0 items-center justify-center rounded-2xl bg-accent-50 text-accent-600">
              <Icon name={option.icon} class="h-8 w-8" />
            </span>
            <div>
              <p class="text-sm font-semibold uppercase tracking-wide text-accent-600">
                {option.tagline}
              </p>
              <p class="mt-1.5 max-w-xl text-lg leading-relaxed text-ink-700">{option.description}</p>
            </div>
          </div>
        ))
      }
    </div>

    {/* Comparación "quién lo hace": tabla única, no cards repetidas. */}
    <div class="reveal mt-12 overflow-hidden rounded-card border border-ink-200">
      <div class="grid grid-cols-[1fr_auto_auto] items-center gap-3 bg-ink-50 px-4 py-3 sm:gap-6 sm:px-7">
        <span class="text-xs font-semibold uppercase tracking-wide text-ink-500">¿Quién lo hace?</span>
        {
          serviceModel.options.map((option) => (
            <span class="w-20 text-center text-[11px] font-semibold uppercase leading-tight tracking-wide text-ink-500 sm:w-28 sm:text-xs">
              {option.shortLabel}
            </span>
          ))
        }
      </div>
      {
        serviceModel.tasks.map((task, i) => (
          <div
            class:list={[
              'grid grid-cols-[1fr_auto_auto] items-center gap-3 px-4 py-4 sm:gap-6 sm:px-7',
              { 'border-t border-ink-100': i > 0 },
            ]}
          >
            <span class="text-sm font-medium text-ink-800">{task.label}</span>
            <span class="flex w-20 justify-center sm:w-28">
              {task.auto === 'tu' ? (
                <span class="inline-flex items-center gap-1.5 rounded-full bg-accent-50 px-2.5 py-1 text-xs font-semibold text-accent-700">
                  <Icon name="check" class="h-3.5 w-3.5" />
                  Tú
                </span>
              ) : (
                <span class="text-xs font-medium text-ink-400">Certimedia</span>
              )}
            </span>
            <span class="flex w-20 justify-center sm:w-28">
              {task.managed === 'tu' ? (
                <span class="inline-flex items-center gap-1.5 rounded-full bg-accent-50 px-2.5 py-1 text-xs font-semibold text-accent-700">
                  <Icon name="check" class="h-3.5 w-3.5" />
                  Tú
                </span>
              ) : (
                <span class="inline-flex items-center gap-1.5 rounded-full bg-ink-100 px-2.5 py-1 text-xs font-semibold text-ink-600">
                  <Icon name="check" class="h-3.5 w-3.5" />
                  Certimedia
                </span>
              )}
            </span>
          </div>
        ))
      }
    </div>

    <p class="reveal mt-8 text-center text-base font-medium text-ink-700">{serviceModel.closing}</p>
  </div>
</section>

<script>
  (function () {
    const tabs = Array.from(document.querySelectorAll('[data-model-tab]'));
    const panels = Array.from(document.querySelectorAll('[data-model-panel]'));
    const thumb = document.getElementById('model-switch-thumb');
    if (tabs.length === 0) return;

    function select(index) {
      tabs.forEach((tab, i) => {
        const active = i === index;
        tab.setAttribute('aria-selected', String(active));
        tab.classList.toggle('text-white', active);
        tab.classList.toggle('text-ink-600', !active);
      });
      panels.forEach((panel, i) => {
        const active = i === index;
        panel.classList.toggle('opacity-0', !active);
        panel.classList.toggle('pointer-events-none', !active);
      });
      if (thumb) {
        thumb.style.transform = index === 0 ? 'translateX(0)' : 'translateX(100%)';
      }
    }

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(i));
    });

    select(0);
  })();
</script>
