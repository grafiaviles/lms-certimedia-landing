---
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
import { comparison } from '../content/copy';

const certimediaIndex = comparison.columns.length - 1;
---

<section id="comparacion" class="bg-white py-16 sm:py-24">
  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
    <SectionHeading
      eyebrow={comparison.eyebrow}
      title={comparison.title}
      description={comparison.subtitle}
    />

    <div class="reveal mt-10" data-comparison>
      {/* Controles: filtro por tema */}
      <div
        role="group"
        aria-label="Filtrar comparación por tema"
        class="flex flex-wrap gap-2"
        data-topic-filters
      >
        {
          comparison.topics.map((topic) => (
            <button
              type="button"
              data-topic-btn={topic}
              aria-pressed={topic === 'Todo' ? 'true' : 'false'}
              class="rounded-full border px-3.5 py-1.5 text-sm font-medium transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-500"
            >
              {topic}
            </button>
          ))
        }
      </div>

      {/* Tabla real (desktop / tablet) */}
      <div class="mt-6 hidden overflow-hidden rounded-card border border-ink-200 md:block">
        <table class="w-full border-collapse text-sm" data-comparison-table>
          <caption class="sr-only">
            Comparación entre {comparison.columns.join(', ')} por tema: SENCE, operación y clientes.
          </caption>
          <thead>
            <tr class="bg-ink-50">
              <th scope="col" class="w-[26%] px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-ink-500">
                &nbsp;
              </th>
              {
                comparison.columns.map((col, ci) => (
                  <th
                    scope="col"
                    data-col={ci}
                    class:list={[
                      'px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide',
                      ci === certimediaIndex ? 'bg-accent-600 text-white' : 'text-ink-500',
                    ]}
                  >
                    {col}
                  </th>
                ))
              }
            </tr>
          </thead>
          <tbody>
            {
              comparison.rows.map((row, ri) => (
                <Fragment>
                  <tr data-topic={row.topic} class="border-t border-ink-100">
                    <th scope="row" class="px-4 py-3.5 text-left align-top text-sm font-semibold text-ink-900">
                      {row.detail ? (
                        <button
                          type="button"
                          data-row-toggle
                          aria-expanded="false"
                          aria-controls={`row-detail-${ri}`}
                          class="flex items-start gap-1.5 text-left focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-500"
                        >
                          <span>{row.label}</span>
                          <Icon
                            name="chevron-down"
                            data-row-chevron
                            class="mt-0.5 h-4 w-4 shrink-0 text-ink-400 transition-transform duration-200"
                          />
                        </button>
                      ) : (
                        row.label
                      )}
                    </th>
                    {
                      row.cells.map((cell, ci) => (
                        <td
                          data-col={ci}
                          class:list={[
                            'px-4 py-3.5 align-top text-sm leading-relaxed',
                            ci === certimediaIndex ? 'bg-accent-600 font-medium text-white' : 'text-ink-600',
                          ]}
                        >
                          {cell}
                        </td>
                      ))
                    }
                  </tr>
                  {row.detail && (
                    <tr id={`row-detail-${ri}`} data-topic={row.topic} data-row-detail class="hidden border-t border-ink-100 bg-ink-50/60">
                      <td colspan={comparison.columns.length + 1} class="px-4 py-3 text-sm leading-relaxed text-ink-600">
                        {row.detail}
                      </td>
                    </tr>
                  )}
                </Fragment>
              ))
            }
          </tbody>
        </table>
      </div>

      {/* Tarjetas apiladas (móvil): mismos datos, sin tabla ni scroll horizontal */}
      <div class="mt-6 space-y-3 md:hidden">
        {
          comparison.rows.map((row, ri) => (
            <div data-topic={row.topic} class="rounded-card border border-ink-200 p-4">
              {row.detail ? (
                <button
                  type="button"
                  data-row-toggle
                  aria-expanded="false"
                  aria-controls={`row-detail-m-${ri}`}
                  class="flex w-full items-start justify-between gap-2 text-left focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-500"
                >
                  <span class="text-sm font-semibold text-ink-900">{row.label}</span>
                  <Icon
                    name="chevron-down"
                    data-row-chevron
                    class="mt-0.5 h-4 w-4 shrink-0 text-ink-400 transition-transform duration-200"
                  />
                </button>
              ) : (
                <p class="text-sm font-semibold text-ink-900">{row.label}</p>
              )}

              <dl class="mt-3 space-y-2.5 border-t border-ink-100 pt-3">
                {
                  row.cells.map((cell, ci) => (
                    <div
                      data-col={ci}
                      class:list={[ci === certimediaIndex && 'rounded-lg bg-accent-600 p-2.5 -mx-1']}
                    >
                      <dt
                        class:list={[
                          'text-[11px] font-semibold uppercase tracking-wide',
                          ci === certimediaIndex ? 'text-white/80' : 'text-ink-400',
                        ]}
                      >
                        {comparison.columns[ci]}
                      </dt>
                      <dd
                        class:list={[
                          'mt-0.5 text-sm leading-relaxed',
                          ci === certimediaIndex ? 'font-medium text-white' : 'text-ink-600',
                        ]}
                      >
                        {cell}
                      </dd>
                    </div>
                  ))
                }
              </dl>

              {row.detail && (
                <p id={`row-detail-m-${ri}`} data-row-detail class="mt-3 hidden border-t border-ink-100 pt-3 text-sm leading-relaxed text-ink-600">
                  {row.detail}
                </p>
              )}
            </div>
          ))
        }
      </div>

      <p class="mt-5 text-xs text-ink-500">{comparison.footnote}</p>
    </div>
  </div>
</section>

<script>
  (function () {
    const root = document.querySelector('[data-comparison]');
    if (!root) return;

    // --- Filtro por tema ---
    const topicButtons = Array.from(root.querySelectorAll('[data-topic-btn]'));
    const filterableRows = Array.from(root.querySelectorAll('[data-topic]'));

    function applyTopic(topic) {
      topicButtons.forEach((btn) => {
        const active = btn.dataset.topicBtn === topic;
        btn.setAttribute('aria-pressed', String(active));
        btn.classList.toggle('bg-accent-600', active);
        btn.classList.toggle('border-accent-600', active);
        btn.classList.toggle('text-white', active);
        btn.classList.toggle('border-ink-200', !active);
        btn.classList.toggle('text-ink-600', !active);
        btn.classList.toggle('hover:border-accent-200', !active);
      });

      filterableRows.forEach((row) => {
        // Las filas de detalle expandido se manejan aparte (no deben reaparecer solas).
        if (row.hasAttribute('data-row-detail')) return;
        const matches = topic === 'Todo' || row.dataset.topic === topic;
        row.classList.toggle('hidden', !matches);

        if (!matches) {
          // Oculta también el detalle asociado si la fila principal se esconde.
          const toggle = row.querySelector('[data-row-toggle]');
          const detailId = toggle?.getAttribute('aria-controls');
          if (detailId) {
            const detail = document.getElementById(detailId);
            detail?.classList.add('hidden');
            toggle?.setAttribute('aria-expanded', 'false');
            toggle?.querySelector('[data-row-chevron]')?.classList.remove('rotate-180');
          }
        }
      });
    }

    topicButtons.forEach((btn) => {
      btn.addEventListener('click', () => applyTopic(btn.dataset.topicBtn));
    });
    applyTopic('Todo');

    // --- Filas expandibles (detalle opcional) ---
    const rowToggles = Array.from(root.querySelectorAll('[data-row-toggle]'));
    rowToggles.forEach((toggle) => {
      toggle.addEventListener('click', () => {
        const isOpen = toggle.getAttribute('aria-expanded') === 'true';
        toggle.setAttribute('aria-expanded', String(!isOpen));
        toggle.querySelector('[data-row-chevron]')?.classList.toggle('rotate-180', !isOpen);
        const detailId = toggle.getAttribute('aria-controls');
        const detail = detailId ? document.getElementById(detailId) : null;
        detail?.classList.toggle('hidden', isOpen);
      });
    });
  })();
</script>
