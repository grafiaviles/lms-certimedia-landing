---
import Illustration from './Illustration.astro';
import Icon from './Icon.astro';
import { howItWorks } from '../content/copy';
---

<section id="como-funciona" class="bg-ink-900 py-16 sm:py-24">
  <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
    <div class="reveal mx-auto max-w-2xl text-center">
      <p class="mb-3 text-sm font-semibold uppercase tracking-wide text-accent-400">
        {howItWorks.eyebrow}
      </p>
      <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">{howItWorks.title}</h2>
      <p
        class="mt-5 inline-flex items-center gap-2 rounded-full bg-white/10 px-4 py-1.5 text-sm font-medium text-accent-100 ring-1 ring-white/15"
      >
        <Icon name="bell" class="h-4 w-4 text-accent-400" />
        {howItWorks.note}
      </p>
    </div>

    {/* Rail de pasos: numerados, clicables, con una barra que avanza sola. */}
    <div id="hiw" class="reveal mt-16">
      <div class="relative flex items-start justify-between">
        <div class="absolute left-5 right-5 top-5 h-0.5 -translate-y-1/2 bg-white/10 sm:left-6 sm:right-6" />
        <div
          id="hiw-fill"
          class="absolute left-5 top-5 h-0.5 -translate-y-1/2 bg-accent-500 transition-[width] duration-700 ease-out sm:left-6"
          style="width: 0%"
        >
        </div>
        {
          howItWorks.steps.map((step, i) => (
            <button
              type="button"
              data-hiw-step={i}
              aria-label={`Paso ${i + 1}: ${step.title}`}
              class="group relative z-10 flex flex-col items-center gap-2.5 bg-transparent px-1"
            >
              <span
                data-hiw-dot
                class="flex h-10 w-10 items-center justify-center rounded-full border-2 border-white/20 bg-ink-900 text-sm font-bold text-white/50 transition-all duration-300 group-hover:border-white/40 sm:h-12 sm:w-12"
              >
                {i + 1}
              </span>
              <span
                data-hiw-label
                class="hidden max-w-[6rem] text-center text-xs font-medium text-ink-400 transition-colors duration-300 sm:block"
              >
                {step.title}
              </span>
            </button>
          ))
        }
      </div>

      {/* Panel con crossfade: ilustración grande + título + descripción del paso activo. */}
      <div class="relative mt-10 min-h-[16rem] overflow-hidden rounded-card bg-white/5 ring-1 ring-white/10 sm:min-h-[11rem]">
        {
          howItWorks.steps.map((step, i) => (
            <div
              data-hiw-panel={i}
              class:list={[
                'absolute inset-0 flex flex-col items-center gap-6 p-6 text-center transition-opacity duration-300 sm:flex-row sm:p-8 sm:text-left',
                { 'pointer-events-none opacity-0': i !== 0 },
              ]}
            >
              <span class="flex h-20 w-20 shrink-0 items-center justify-center rounded-2xl bg-white/10">
                <Illustration name={step.illustration} class="h-14 w-14" />
              </span>
              <div>
                <p class="text-xs font-semibold uppercase tracking-wide text-accent-400">
                  Paso {i + 1} de {howItWorks.steps.length}
                </p>
                <h3 class="mt-1.5 text-xl font-bold text-white">{step.title}</h3>
                <p class="mt-2 max-w-md text-sm leading-relaxed text-ink-300">{step.description}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  (function () {
    const root = document.getElementById('hiw');
    if (!root) return;

    const buttons = Array.from(root.querySelectorAll('[data-hiw-step]'));
    const panels = Array.from(root.querySelectorAll('[data-hiw-panel]'));
    const fill = document.getElementById('hiw-fill');
    if (buttons.length === 0) return;

    const total = buttons.length;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let index = 0;
    let timer = null;

    function select(next) {
      index = (next + total) % total;

      buttons.forEach((btn, i) => {
        const active = i === index;
        const dot = btn.querySelector('[data-hiw-dot]');
        const label = btn.querySelector('[data-hiw-label]');
        dot?.classList.toggle('bg-accent-500', active);
        dot?.classList.toggle('border-accent-500', active);
        dot?.classList.toggle('text-white', active);
        dot?.classList.toggle('bg-ink-900', !active);
        dot?.classList.toggle('border-white/20', !active);
        dot?.classList.toggle('text-white/50', !active);
        label?.classList.toggle('text-white', active);
        label?.classList.toggle('text-ink-400', !active);
      });

      panels.forEach((panel, i) => {
        const active = i === index;
        panel.classList.toggle('opacity-0', !active);
        panel.classList.toggle('pointer-events-none', !active);
      });

      if (fill) {
        fill.style.width = `${(index / (total - 1)) * 100}%`;
      }
    }

    function start() {
      if (reduceMotion || timer) return;
      timer = window.setInterval(() => select(index + 1), 4500);
    }

    function stop() {
      if (timer) {
        clearInterval(timer);
        timer = null;
      }
    }

    buttons.forEach((btn, i) => {
      btn.addEventListener('click', () => {
        select(i);
        stop();
        start();
      });
    });

    root.addEventListener('mouseenter', stop);
    root.addEventListener('mouseleave', start);
    root.addEventListener('focusin', stop);
    root.addEventListener('focusout', start);

    select(0);
    start();
  })();
</script>
