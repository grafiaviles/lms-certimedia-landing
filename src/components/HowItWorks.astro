---
import Illustration from './Illustration.astro';
import Icon from './Icon.astro';
import { howItWorks } from '../content/copy';
---

<section id="como-funciona" class="bg-ink-900 py-16 sm:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="reveal mx-auto max-w-2xl text-center">
      <p class="mb-3 text-sm font-semibold uppercase tracking-wide text-accent-400">
        {howItWorks.eyebrow}
      </p>
      <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">{howItWorks.title}</h2>
      <p
        class="mt-5 inline-flex items-center gap-2 rounded-full bg-white/10 px-4 py-1.5 text-sm font-medium text-accent-100 ring-1 ring-white/15"
      >
        <Icon name="bell" class="h-4 w-4 text-accent-400" />
        {howItWorks.note}
      </p>
    </div>

    <ol class="relative mt-16 grid gap-10 sm:grid-cols-2 lg:grid-cols-4 lg:gap-8">
      {/* Línea conectora del timeline (desktop). */}
      <div
        class="pointer-events-none absolute inset-x-0 top-8 hidden h-px bg-white/15 lg:block"
        aria-hidden="true"
      >
      </div>

      {
        howItWorks.steps.map((step, i) => (
          <li
            class="reveal relative flex flex-col items-center text-center lg:items-start lg:text-left"
            style={`transition-delay: ${i * 90}ms`}
          >
            <div class="relative z-10 mb-5">
              <Illustration name={step.illustration} class="h-16 w-16" />
              <span class="absolute -right-2 -top-2 flex h-7 w-7 items-center justify-center rounded-full bg-accent-500 text-xs font-bold text-white ring-4 ring-ink-900">
                {i + 1}
              </span>
            </div>
            <h3 class="text-base font-semibold text-white">{step.title}</h3>
            <p class="mt-2 max-w-xs text-sm leading-relaxed text-ink-300 lg:max-w-none">
              {step.description}
            </p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
