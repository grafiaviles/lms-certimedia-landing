---
import Icon from './Icon.astro';
---

<div
  class="mx-auto w-full max-w-md overflow-hidden rounded-2xl border border-ink-200 bg-white shadow-soft sm:rounded-card"
  role="img"
  aria-label="Vista ilustrativa del panel del LMS Certimedia, con alerta de cierre SENCE, asistencia y avance de cohortes."
>
  <div class="flex items-center gap-2 border-b border-ink-100 bg-ink-50 px-4 py-3">
    <span class="h-2.5 w-2.5 rounded-full bg-ink-300"></span>
    <span class="h-2.5 w-2.5 rounded-full bg-ink-300"></span>
    <span class="h-2.5 w-2.5 rounded-full bg-ink-300"></span>
    <span class="ml-2 text-xs font-medium text-ink-500">Panel OTEC · LMS Certimedia</span>
  </div>

  <div class="space-y-4 p-4 sm:p-5">
    <div class="flex items-start gap-3 rounded-xl border border-accent-200 bg-accent-50 p-3">
      <Icon name="bell" class="mt-0.5 h-5 w-5 shrink-0 text-accent-700" />
      <div>
        <p class="text-sm font-semibold text-accent-800">Declaración Jurada SENCE</p>
        <p class="text-xs text-accent-700">Cierra en 5 días · 3 cohortes pendientes</p>
      </div>
    </div>

    <div class="grid grid-cols-3 gap-3">
      <div class="rounded-xl border border-ink-100 p-3">
        <p class="text-xs text-ink-500">Asistencia</p>
        <p class="mt-1 text-xl font-bold text-ink-900">96%</p>
      </div>
      <div class="rounded-xl border border-ink-100 p-3">
        <p class="text-xs text-ink-500">Cohortes activas</p>
        <p class="mt-1 text-xl font-bold text-ink-900">12</p>
      </div>
      <div class="rounded-xl border border-ink-100 p-3">
        <p class="text-xs text-ink-500">Empresas</p>
        <p class="mt-1 text-xl font-bold text-ink-900">8</p>
      </div>
    </div>

    <div class="rounded-xl border border-ink-100 p-4">
      <p class="mb-3 text-xs font-medium text-ink-500">Avance por cohorte</p>
      <div class="space-y-2.5">
        {
          [
            { label: 'Prevención de riesgos', value: 82 },
            { label: 'Excel intermedio', value: 64 },
            { label: 'Atención a cliente', value: 45 },
          ].map((row) => (
            <div>
              <div class="mb-1 flex items-center justify-between text-xs text-ink-600">
                <span>{row.label}</span>
                <span class="font-medium text-ink-800">{row.value}%</span>
              </div>
              <div class="h-2 overflow-hidden rounded-full bg-ink-100">
                <div
                  class="h-full rounded-full bg-accent-500"
                  style={`width: ${row.value}%`}
                >
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>

    <div class="flex items-center justify-between rounded-xl border border-ink-100 p-3">
      <div class="flex items-center gap-2">
        <Icon name="badge" class="h-5 w-5 text-accent-600" />
        <p class="text-sm font-medium text-ink-700">Diplomas generados hoy</p>
      </div>
      <p class="text-sm font-bold text-ink-900">24</p>
    </div>
  </div>
</div>
