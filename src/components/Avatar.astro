---
// Avatares de personas ilustrados (estilo flat), diversos en tono de piel, peinado y color.
// Inline SVG, sin dependencias ni imágenes externas.
interface Props {
  variant?: number;
  class?: string;
}

const { variant = 0, class: className = 'h-10 w-10' } = Astro.props;

const variants = [
  { bg: '#DBEAFE', skin: '#F2C9A0', hair: '#2E2A27', shirt: '#2563EB', type: 'short', glasses: false },
  { bg: '#CCFBF1', skin: '#8D5524', hair: '#141414', shirt: '#0D9488', type: 'curly', glasses: false },
  { bg: '#FEF3C7', skin: '#E0A878', hair: '#3B2F2F', shirt: '#D97706', type: 'bun', glasses: false },
  { bg: '#FFE4E6', skin: '#F5D6B8', hair: '#5A3A22', shirt: '#E11D48', type: 'long', glasses: false },
  { bg: '#EDE9FE', skin: '#C68642', hair: '#242424', shirt: '#7C3AED', type: 'short', glasses: true },
];

const v = variants[variant % variants.length];
const uid = 'av-' + Math.random().toString(36).slice(2, 9);
---

<svg
  class={className}
  viewBox="0 0 64 64"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  role="img"
>
  <defs>
    <clipPath id={uid}>
      <circle cx="32" cy="32" r="32"></circle>
    </clipPath>
  </defs>
  <g clip-path={`url(#${uid})`}>
    <rect width="64" height="64" fill={v.bg}></rect>

    {/* Hombros / polera */}
    <path d="M8 64 C8 50 18 45 32 45 C46 45 56 50 56 64 Z" fill={v.shirt}></path>

    {/* Cuello */}
    <rect x="27" y="33" width="10" height="11" rx="4" fill={v.skin}></rect>

    {/* Cabeza */}
    <circle cx="32" cy="25" r="12" fill={v.skin}></circle>

    {/* Pelo según tipo */}
    {
      v.type === 'short' && (
        <path d="M20 24 C20 12 44 12 44 24 C44 16.5 39 13 32 13 C25 13 20 16.5 20 24 Z" fill={v.hair} />
      )
    }
    {
      v.type === 'buzz' && (
        <path d="M21 23 C21 14 43 14 43 23 C43 17 38 14.5 32 14.5 C26 14.5 21 17 21 23 Z" fill={v.hair} />
      )
    }
    {
      v.type === 'bun' && (
        <g fill={v.hair}>
          <circle cx="32" cy="11" r="4" />
          <path d="M20 24 C20 12 44 12 44 24 C44 16.5 39 13 32 13 C25 13 20 16.5 20 24 Z" />
        </g>
      )
    }
    {
      v.type === 'long' && (
        <g fill={v.hair}>
          <path d="M18 23 L18 43 L23 43 L23 26 Z" />
          <path d="M46 23 L46 43 L41 43 L41 26 Z" />
          <path d="M19 24 C19 11 45 11 45 24 C45 16 40 12.5 32 12.5 C24 12.5 19 16 19 24 Z" />
        </g>
      )
    }
    {
      v.type === 'curly' && (
        <g fill={v.hair}>
          <circle cx="22" cy="19" r="6" />
          <circle cx="30" cy="14" r="7" />
          <circle cx="39" cy="15" r="6.5" />
          <circle cx="44" cy="21" r="5.5" />
          <circle cx="20" cy="24" r="5" />
        </g>
      )
    }

    {/* Rostro */}
    <circle cx="28" cy="25.5" r="1.3" fill="#2b2b2b"></circle>
    <circle cx="36" cy="25.5" r="1.3" fill="#2b2b2b"></circle>
    <path
      d="M28.5 30 Q32 32.5 35.5 30"
      fill="none"
      stroke="#2b2b2b"
      stroke-width="1.3"
      stroke-linecap="round"></path>

    {
      v.glasses && (
        <g stroke="#2b2b2b" stroke-width="1.2" fill="none">
          <circle cx="28" cy="25.5" r="3.2" />
          <circle cx="36" cy="25.5" r="3.2" />
          <path d="M31.2 25.5 h1.6" />
        </g>
      )
    }
  </g>
</svg>
